{
  "assistant_name": "JARVIS",
  "user_name": "Monsieur",
  "user_city": "Lomé",
  "wake_words": [
    "jarvis"
  ],
  "voice": "fr-FR-HenriNeural",
  "preferred_brain": "gemini",
  "mic_device_index": null,
  "mic_sensitivity_rms": 0.015,
  "silence_duration_sec": 1.2,
  "max_phrase_sec": 15.0,
  "sound_feedback": true,
  "orb_theme": "tesla_coil",
  "orb_animation": "quantum",
  "auto_listen": true,
  "model_choice_mode": "ask",
  "models": {
    "tiers": {
      "chat": "gemini/gemini-3.1-flash-lite-preview",
      "light": "gemini/gemini-3.5-flash-lite",
      "heavy": "gemini/gemini-3.8-flash"
    }
  },
  "orb_quality": "high",
  "orb_preset": "tesla_coil",
  "chat_autoshow": false,
  "tools_default_permission": "allow",
  "agent": {
    "fallback_rules": [
      {
        "pattern": "^annule(?:r)?\\s+(?:le\\s+|les\\s+)?(minuteur|timer|compte à rebours)",
        "action": "cancel_timer",
        "params": {}
      },
      {
        "pattern": "^mets?\\s+(?:le\\s+)?volume\\s+(?:à|a)\\s+(\\d{1,3})",
        "action": "set_system_volume",
        "params": {
          "level": "{1}"
        }
      },
      {
        "pattern": "^ouvre\\s+(?:le\\s+|la\\s+|l')?(chrome|edge|firefox|notepad|bloc-notes|calculatrice|spotify|youtube)$",
        "action": "open_app",
        "params": {
          "app_name": "{1}"
        }
      }
    ]
  },
  "tool_permissions": {}
}